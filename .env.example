# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_agriculture

# Environment: development | production
# In production FLASK_SECRET_KEY and JWT_SECRET_KEY are REQUIRED (the app refuses to start without them).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development

# Comma-separated list of allowed dashboard origins (required in production, e.g. https://agrisense.example.com)
CORS_ORIGINS=

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=false

# JWT
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your-api-key-here

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
